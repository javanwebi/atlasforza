+/** Only mirrors Supabase Auth's own test-number mapping; never verifies an OTP here. */
+export function previewOtp(phone:string, env:NodeJS.ProcessEnv=process.env):string|undefined {
+ if(env.APP_ENV!=='preview' || env.DATABASE_ENV!=='development')return;
+ const until=Date.parse(env.PREVIEW_OTP_VALID_UNTIL || '');
+ if(!Number.isFinite(until) || until<=Date.now())return;
+ const wanted=phone.replace(/^\+/, '');
+ for(const entry of (env.SUPABASE_PREVIEW_TEST_OTPS || '').split(',')){
+  const [number,code]=entry.trim().split(':');
+  if(number===wanted && /^\d{6}$/.test(code || ''))return code;
+ }
+}
+export function previewOtpResponse(code:string|undefined){
+ return code ? {previewCode:code,message:'محیط آزمایشی: کد را وارد کنید. مالکیت واقعی شماره با این روش تأیید نمی‌شود.'} : {};
+}
